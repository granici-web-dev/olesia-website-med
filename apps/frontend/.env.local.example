# Frontend environment — copy to .env.local (gitignored).
# Every variable below is read somewhere under apps/frontend; nothing here is
# aspirational. Values are deliberately absent: this file names the knobs, the
# real values live in Vercel's project settings.

# ---------------------------------------------------------------- API

# The content API's base URL, read on the server: lib/api.ts (all page content)
# and next.config.ts, which derives the allowed next/image host from it — an
# uploaded photo will not render if this is wrong. Defaults to
# http://localhost:3333/api.
# API_URL=

# The same origin, read in the browser: lib/uploads.ts (patient file upload) and
# lib/leads.ts (contact, EXPRESS, deliverable and newsletter forms). Must be
# publicly reachable; same default.
# NEXT_PUBLIC_API_URL=

# The site's own public origin, no trailing slash. robots.txt and sitemap.xml
# need absolute URLs, so this is what they are built from. On Vercel it falls
# back to VERCEL_PROJECT_PRODUCTION_URL, which points at production even from a
# preview deployment; set this explicitly once the real domain is delegated.
# NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------- Booking

# Overrides the built-in free-consultation Calendly link. The built-in one
# points at the developer's test account — replace it before launch.
# NEXT_PUBLIC_CALENDLY_FREE_URL=

# ---------------------------------------------------------------- Analytics

# All four are optional and independent; with none of them set the analytics
# stack is a no-op and no third-party script is ever loaded. Consent comes from
# the self-hosted banner (CookieConsent v3): GTM and GA4 wait for the analytics
# category, the Pixel for marketing.

# Google Tag Manager container — the recommended umbrella, manage GA4 and the
# Pixel inside it rather than setting them here as well.
# NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 measurement ID, if loaded directly instead of through GTM.
# NEXT_PUBLIC_GA4_ID=

# Meta (Facebook) Pixel ID.
# NEXT_PUBLIC_META_PIXEL_ID=

# Google Search Console verification token. Renders a <meta> tag and sets no
# cookie, so it is outside the consent gate.
# NEXT_PUBLIC_GSC_VERIFICATION=

# ---------------------------------------------------------------- Forms

# Google reCAPTCHA v3 site key. Empty means forms behave exactly as before and
# no Google script is loaded. The script loads lazily, on the first submit. The
# matching RECAPTCHA_SECRET belongs to the API, which verifies the token
# server-side — a site key alone protects nothing.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Newsletter signup target: a provider-agnostic endpoint that accepts
# {email, locale, source, consent}. Empty hides the signup everywhere. Prefer a
# same-origin URL to avoid CORS.
# NEXT_PUBLIC_NEWSLETTER_ENDPOINT=

# ---------------------------------------------------------------- Image generation

# Used only by `pnpm --filter @olesia/frontend gen:images`
# (scripts/generate-images.ts), never at runtime. The script is parked — images
# are uploaded through the back office instead — so these stay unset unless it
# is picked up again.

# Vercel AI Gateway key. On Vercel, VERCEL_OIDC_TOKEN covers this instead; the
# script refuses to start with neither.
# AI_GATEWAY_API_KEY=

# Model override. Default: google/gemini-3.1-flash-image-preview
# GATEWAY_IMAGE_MODEL=
