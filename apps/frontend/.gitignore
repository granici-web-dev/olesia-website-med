# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the example, which is documentation and has to be in the repo.
# CLAUDE.md and AGENTS.md both point readers at it; the broad pattern above had
# been quietly excluding it since the app was scaffolded.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent rules written by `next dev`
# It regenerates both on every start (the `nextjs-agent-rules` block at the top
# of AGENTS.md, which CLAUDE.md only imports), so they are build output, not the
# project's own rules — those are the repo-root CLAUDE.md and AGENTS.md.
/AGENTS.md
/CLAUDE.md
