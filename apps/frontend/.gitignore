# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the example, which is documentation and has to be in the repo.
# CLAUDE.md and AGENTS.md both point readers at it; the broad pattern above had
# been quietly excluding it since the app was scaffolded.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AGENTS.md and CLAUDE.md here are committed on purpose (2026-09-16): `next dev`
# writes the `nextjs-agent-rules` block at the top of AGENTS.md and a one-line
# CLAUDE.md that imports it, and the project's frontend rules live below that
# block. Keep the generated block; Claude Code loads this file only when working
# inside apps/frontend, which is the point.
