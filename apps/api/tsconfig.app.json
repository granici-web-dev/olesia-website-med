{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node"],
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021",
    // sharp ships `lib/index.d.ts` but its `exports` map has no `types`
    // condition, so `moduleResolution: nodenext` cannot find it and the import
    // silently becomes `any`. Point at the real declarations instead of
    // loosening the compiler for the whole app. Drop this once sharp declares
    // types in its exports map.
    "paths": {
      "sharp": ["../../node_modules/sharp/lib/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ],
  "references": [{ "path": "../../packages/shared/tsconfig.lib.json" }]
}
