// Prisma schema — olesia-website-med backend.
// Enums mirror packages/shared/src/lib/enums.ts (keep them in sync).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---

/// Which language to write back to this person in. Mirrors `Locale` in
/// packages/shared; `ro` is the default and the fallback.
enum Locale {
  ro
  en
  ru
}

enum Role {
  admin
  editor
}

enum ServiceCode {
  pediatric
  // Nutrition is two services, split by audience (brief §1). Same length and
  // price; different Calendly event types, which is what the webhook routes on.
  nutrition_copii
  nutrition_adulti
  integrative
  monitoring
  quick_question
  free_consult
}

enum ServiceGroup {
  A_booking
  B_portal
}

enum AppointmentStatus {
  scheduled
  canceled
  completed
  no_show
}

enum PaymentStatus {
  pending
  confirmed
}

enum PostStatus {
  draft
  published
}

enum ContactType {
  phone
  email
  address
  social
  other
}

enum SubscriptionStatus {
  active
  paused
  expired
  canceled
}

enum QuickQuestionStatus {
  /// Written, not paid for, invisible to the doctor. See the QuickQuestion
  /// model comment and docs/shape-express-checkout.md.
  awaiting_payment
  open
  answered
  closed
}

enum ContactMessageStatus {
  new
  read
  replied
}

enum DeliverableProduct {
  menu_7
  menu_14
  menu_30
  protocol_pednutri
  protocol_complementary
}

enum DeliverableOrderStatus {
  /// Ordered, not paid for, invisible to the doctor — the same state an
  /// EXPRESS ticket starts in, for the same reason. See the DeliverableOrder
  /// model comment and docs/shape-paid-deliverables-and-materials.md.
  awaiting_payment
  new
  in_progress
  delivered
  canceled
}

enum UploadLinkTarget {
  appointment
  deliverable_order
}

// --- Back-office users ---

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(editor)
  isActive     Boolean  @default(true)
  /// Set when an admin creates or resets the account: the starter password was
  /// chosen by somebody else and read off their screen, so it is a handover,
  /// not a password. Login says so and the back office insists before it lets
  /// the account any further.
  mustChangePassword Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // --- Two-factor authentication (TOTP), client answers v2 §10 ---
  /// Base32 TOTP secret. Present from the moment enrolment starts; only
  /// `totpEnabled` decides whether it is actually required at login.
  totpSecret       String?
  totpEnabled      Boolean  @default(false)
  totpEnabledAt    DateTime?
  /// Argon2 hashes of single-use recovery codes — never the codes themselves,
  /// so a database leak cannot be used to bypass the second factor.
  totpRecoveryCodes String[] @default([])
  /// Consecutive wrong second factors. Per account, because the login throttle
  /// counts per IP and a six-digit code is worth spreading across addresses.
  totpFailedCount   Int       @default(0)
  totpLockedUntil   DateTime?

  posts           Post[]
  refreshSessions RefreshSession[]
}

/// One issued refresh token, so that a session can be ended rather than only
/// expiring: a signed token nobody records cannot be revoked at logout, when a
/// password changes, or when it turns out to have been stolen.
model RefreshSession {
  /// The `jti` of the refresh JWT handed to the browser.
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  expiresAt DateTime
  revokedAt DateTime?
  /// The session this one was rotated into. A plain id, not a relation: it is
  /// an audit trail for reuse detection, and a self-relation would buy nothing
  /// but a foreign key that has to be nulled on delete.
  replacedById String?

  /// Truncated, for telling one's own sessions apart in a future session list.
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// --- Service catalog (5 services) ---
//
// Every content model carries three locales. RO and EN are required (the site
// launched bilingual); RU is nullable because the existing rows predate it and
// because a half-translated page must still save. Readers fall back RU → RO,
// so a missing translation degrades to Romanian instead of an empty screen.

model Service {
  id                   String       @id @default(uuid())
  code                 ServiceCode  @unique
  group                ServiceGroup
  titleRo              String
  titleEn              String
  titleRu              String?
  descriptionRo        String
  descriptionEn        String
  descriptionRu        String?
  durationMin          Int?
  price                Int
  priceLabelRo         String?
  priceLabelEn         String?
  priceLabelRu         String?
  calendlyEventTypeUri String?      @unique // API event_type URI (webhook mapping)
  calendlySchedulingUrl String?     // public booking link for the site embed
  sortOrder            Int          @default(0)
  active               Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  appointments  Appointment[]
  subscriptions Subscription[]
}

// --- Appointments (group A, Calendly) ---

model Appointment {
  id                 String            @id @default(uuid())
  service            Service           @relation(fields: [serviceId], references: [id])
  serviceId          String
  calendlyEventUri   String            @unique // idempotency key
  calendlyInviteeUri String?           @unique // invitee URI, how a reschedule names the row it replaces
  clientName         String
  clientEmail        String
  reason             String?
  startTime          DateTime
  endTime            DateTime
  videoUrl           String?
  status             AppointmentStatus @default(scheduled)
  paymentStatus      PaymentStatus     @default(pending)
  cancelUrl          String?
  rescheduleUrl      String?
  /// Calendly does not tell us the invitee's language, so a booking defaults
  /// to `ro` and the doctor can correct it in the back office.
  locale             Locale            @default(ro)
  prepSentAt         DateTime?
  planText           String? // written treatment plan typed by the specialist
  planFileKey        String? // PRIVATE storage key of an optional attachment (rx/doc)
  planFileName       String? // original filename of the attachment, for download
  planUploadedAt     DateTime?
  patient            Patient?          @relation(fields: [patientId], references: [id])
  patientId          String?
  // A rescheduled booking is a new Calendly event, so it is a new row; this
  // points at the canceled one it grew out of.
  rescheduledFrom    Appointment?      @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id])
  rescheduledFromId  String?           @unique
  rescheduledTo      Appointment?      @relation("AppointmentReschedule")
  uploadLinks        UploadLink[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([serviceId])
  @@index([status])
  @@index([startTime])
  @@index([patientId])
}

// --- Subscriptions (service 04) ---

model Subscription {
  id                 String             @id @default(uuid())
  service            Service            @relation(fields: [serviceId], references: [id])
  serviceId          String
  clientName         String
  clientEmail        String
  phone              String? // lead contact phone (public intake)
  notes              String? // free-text message from the public lead form
  locale             Locale             @default(ro)
  status             SubscriptionStatus @default(active)
  paymentStatus      PaymentStatus      @default(pending)
  /// Video calls included for the whole subscription, not per month, and it
  /// never resets: nothing has ever decremented `videoQuotaUsed` on a calendar
  /// boundary, so the old name `videoQuotaPerMonth` described a monthly
  /// allowance that did not exist (audit A5, F10). The number the back office
  /// showed was this one multiplied by a hardcoded 3.
  videoQuotaTotal Int                   @default(6)
  videoQuotaUsed  Int                   @default(0)
  startsAt           DateTime
  endsAt             DateTime
  patient            Patient?           @relation(fields: [patientId], references: [id])
  patientId          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([serviceId])
  @@index([status])
  @@index([patientId])
}

// --- Quick questions (service 05) ---

model QuickQuestion {
  id            String              @id @default(uuid())
  clientName    String
  clientEmail   String
  phone         String? // lead contact phone (public intake)
  question      String
  locale        Locale              @default(ro)
  answer        String?
  status        QuickQuestionStatus @default(open)
  paymentStatus PaymentStatus       @default(pending)
  /// When the answer is owed, in working time. Null until the money lands: the
  /// SLA clock starts at payment, not at submission, so an unpaid ticket must
  /// not carry a deadline the back office's overdue counter would then count
  /// (docs/shape-express-checkout.md, approved 2026-09-11).
  dueAt         DateTime?
  answeredAt    DateTime?
  patient       Patient?            @relation(fields: [patientId], references: [id])
  patientId     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status])
  @@index([patientId])
}

// --- Blog ---

model Category {
  id     String @id @default(uuid())
  slug   String  @unique
  nameRo String
  nameEn String
  nameRu String?

  posts Post[]
}

model Post {
  id            String     @id @default(uuid())
  slug          String     @unique
  titleRo       String
  titleEn       String
  titleRu       String?
  excerptRo     String?
  excerptEn     String?
  excerptRu     String?
  contentRo     String
  contentEn     String
  contentRu     String?
  coverImageUrl String?

  /// Keys from the shared child-age taxonomy ('0-6m', '6-12m', …) — the same
  /// one the digital library uses, so one filter covers both surfaces. Empty
  /// means the article is not age-specific, and the age filter always shows it.
  ///
  /// `@default([])` is load-bearing, not decoration: without it the column is
  /// NULL for every row written before this field existed, Prisma reads that
  /// back as `undefined`, and the key silently disappears from the API
  /// response — leaving the public age filter iterating over nothing.
  ageKeys       String[] @default([])

  status        PostStatus @default(draft)
  publishedAt   DateTime?
  author        User       @relation(fields: [authorId], references: [id])
  authorId      String
  categories    Category[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status])
  @@index([authorId])
}

// --- Contacts ---

model Contact {
  id        String      @id @default(uuid())
  type      ContactType
  labelRo   String
  labelEn   String
  labelRu   String?
  value     String
  sortOrder Int         @default(0)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

// --- Site media (hero video, poster, page portraits) ---
//
// A fixed set of SLOTS, not a gallery: each page asks for one specific picture
// and the homepage for one video per locale, so the catalogue of keys lives in
// code (`packages/shared`) and only the file behind each key is editable.
//
// A row here is an OVERRIDE. With no row the site serves the asset committed
// under `apps/frontend/public/assets/`, which is also why swapping a file no
// longer needs the "give it a new filename" trick: every upload lands on a
// fresh UUID URL, so no cache anywhere is holding the old bytes.

model SiteMedia {
  /// Slot key from `SITE_MEDIA_SLOTS`, e.g. `hero_video_ro`, `portrait_about`.
  key      String  @id
  url      String
  /// Intrinsic size — `next/image` needs it for photos; null for video.
  width    Int?
  height   Int?
  /// Original filename, so the back office can show what was uploaded.
  fileName String?

  updatedAt DateTime @updatedAt
}

// --- Biblioteca digitală (downloadable materials, /guides) ---

enum MaterialAccess {
  free
  paid
}

/// Merchandising badges on a material card.
enum MaterialFlag {
  recommended
  popular
  new
}

model MaterialCategory {
  id        String  @id @default(uuid())
  slug      String  @unique
  nameRo    String
  nameEn    String
  nameRu    String?
  sortOrder Int     @default(0)

  materials Material[]
}

model Material {
  id         String           @id @default(uuid())
  slug       String           @unique
  category   MaterialCategory @relation(fields: [categoryId], references: [id])
  categoryId String

  /// Keys from the shared child-age taxonomy ('0-6m', '6-12m', …). Empty means
  /// the material is not age-specific, and the age filter always shows it.
  /// See `Post.ageKeys` for why the default is spelled out.
  ageKeys String[] @default([])

  titleRo       String
  titleEn       String
  titleRu       String?
  descriptionRo String
  descriptionEn String
  descriptionRu String?

  /// Page count and language of the file, rendered as "PDF · 16 pag. · RO".
  /// Stored as data rather than three hand-written strings, so the units follow
  /// the visitor's locale.
  pageCount Int?
  fileLang  String?

  access MaterialAccess @default(free)
  /// Whole EUR, paid materials only. Selling them needs the payments module —
  /// until it exists the storefront routes a purchase to the contact page.
  price  Int?
  flags  MaterialFlag[]

  /// Public URL of the uploaded PDF, for a FREE material. Null while the file
  /// is still missing: the storefront then shows the card as "în curând"
  /// instead of a dead download.
  fileUrl  String?
  /// Private storage key of the PDF, for a PAID one. The two are exclusive:
  /// a paid file never has a public URL, because a URL in the same directory
  /// as the free downloads *is* the file, and withholding it from a DTO is
  /// obscurity rather than access control (audit A4, F1). Released by
  /// `MaterialGrant` after payment.
  fileKey  String?
  fileName String?

  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grants MaterialGrant[]

  @@index([active, sortOrder])
  @@index([categoryId])
}

/// What paying for a material buys: permission to download one file, for a
/// while, a bounded number of times.
///
/// It is a capability, like `UploadLink` and for the same reasons — the token
/// in the URL is the whole credential, it is stored in the clear so the back
/// office can hand the same link over again, and what it opens is one PDF the
/// buyer paid for rather than anybody's medical document.
///
/// The order reference is deliberately *not* the key. It travels to the bank,
/// lives in the merchant portal and lands on card statements, so it is fine as
/// the key to a PII-free status lookup and not fine as the key that hands over
/// a file (docs/shape-express-checkout.md).
model MaterialGrant {
  id String @id @default(uuid())

  /// 32 random bytes, base64url. Long enough that guessing is not a strategy.
  token String @unique

  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialId String

  /// Lowercased, as everywhere a payer's address is stored.
  payerEmail String

  expiresAt     DateTime
  maxDownloads  Int       @default(10)
  downloadCount Int       @default(0)
  lastDownloadAt DateTime?

  /// Which purchase opened it. Null once that Payment is gone; the grant is
  /// the record of what the buyer may do, not of what they were charged.
  paymentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One grant per buyer per material, which is the rule rather than an
  /// optimisation: buying the same guide twice extends the one grant instead
  /// of leaving two live tokens, and the token is kept so a link already
  /// sitting in somebody's inbox goes on working.
  @@unique([materialId, payerEmail])
  @@index([expiresAt])
}

// --- Media appearances (the /media page) ---

enum MediaKind {
  tv
  radio
  conference
  press
}

enum MediaEmbedProvider {
  youtube
  facebook
}

// Recordings are NEVER self-hosted: broadcast rights belong to the channel and
// the files run 30–170 MB. Every item points at its original publication and is
// embedded from there, click-to-load, so the third-party iframe only appears
// after the visitor presses play. The thumbnail, by contrast, IS stored locally
// — calling ytimg/fbcdn on first paint would re-introduce exactly the
// pre-consent third-party request the click-to-load embed avoids.

model MediaAppearance {
  id       String    @id @default(uuid())
  kind     MediaKind
  /// Broadcaster, e.g. "Moldova 1".
  outlet   String
  /// Programme name, e.g. "Bună dimineața".
  show     String?
  /// Broadcast date. Null when the source never published one — the site then
  /// simply omits it rather than guessing.
  date     DateTime?
  /// Runtime as published, "mm:ss".
  duration String?

  titleRo   String
  titleEn   String
  titleRu   String?
  summaryRo String
  summaryEn String
  summaryRu String?

  /// Canonical publication URL — always offered as an outbound link.
  url           String
  embedProvider MediaEmbedProvider
  /// YouTube video id, or the canonical Facebook video permalink.
  embedRef      String

  thumbUrl    String
  thumbWidth  Int
  thumbHeight Int

  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

// --- Testimonials (parent reviews, homepage) ---
//
// Real reviews only. The site has already shipped invented ones twice, so the
// model is shaped to make fabrication awkward: `author` is nullable because an
// unsigned review is a real case, and the site answers it with a localized
// neutral label rather than a name someone made up. `source` records the
// platform a review came from when it came from one.

model Testimonial {
  id      String  @id @default(uuid())
  quoteRo String
  quoteEn String
  quoteRu String?
  /// Null when the reviewer did not sign. Names are never translated, so this
  /// is a single field — the neutral stand-in is UI copy, not data.
  author  String?
  /// Short context under the name ("mamă, Chișinău"). Optional: many reviews
  /// arrive with nothing but the text.
  roleRo  String?
  roleEn  String?
  roleRu  String?
  /// Platform the review was left on, e.g. "DoctorChat" — attribution the
  /// client may be required to display.
  source    String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

// --- FAQ (the public /faq page) ---
//
// Two levels, because the page is built that way: a category is a section with
// its own anchor (`slug` → `/faq#programare`, used by the sticky nav and by
// deep links from the service pages), and the items are the question/answer
// pairs inside it. Rows rather than one JSON blob, so a single question can be
// reordered or hidden without rewriting the others — and so the FAQPage
// JSON-LD is generated from what is actually published.

model FaqCategory {
  id        String   @id @default(uuid())
  /// URL anchor, derived from the Romanian title when the category is created
  /// and never re-derived afterwards: renaming a section must not break links
  /// that are already out there.
  slug      String   @unique
  titleRo   String
  titleEn   String
  titleRu   String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items FaqItem[]
}

model FaqItem {
  id         String      @id @default(uuid())
  category   FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  questionRo String
  questionEn String
  questionRu String?
  answerRo   String
  answerEn   String
  answerRu   String?
  sortOrder  Int         @default(0)
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([categoryId, sortOrder])
}

// --- Contact-form messages (public Contact page → back-office "Mesaje") ---
//
// Non-medical messages submitted from the site's Contact form. The doctor
// reads them in the back office, marks them read and (once SMTP is wired)
// replies by email — `reply`/`repliedAt` are reserved for that next step.

model ContactMessage {
  id        String               @id @default(uuid())
  name      String
  email     String
  subject   String // ContactSubject value: appointment | payment | how_it_works | other
  message   String
  locale    Locale               @default(ro)
  status    ContactMessageStatus @default(new)
  readAt    DateTime?
  reply     String? // email reply text (set when answered from the portal)
  repliedAt DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status])
  @@index([createdAt])
}

// --- Newsletter (brief §6c) ---
//
// A row here is a consent record before it is a mailing address: `consentAt`
// and `consentVersion` say what the person agreed to and when, which is what
// GDPR asks for and what an export from a provider's dashboard would not give
// us. The version is stamped server-side from `NEWSLETTER_CONSENT_VERSION` in
// packages/shared, never taken from the request.
//
// `email` is CITEXT and unique, so `Ana@Gmail.com` and `ana@gmail.com` are one
// subscriber. Re-subscribing the same address is an update, not a second row.
//
// `confirmedAt` is for the double opt-in that becomes possible the day the
// client has an SMTP server. Nothing is sent today and every row is
// unconfirmed; the field exists so confirming later does not need a migration
// against a populated table.

enum SubscriberSource {
  /// The library page (/guides): its email gate in front of a free material,
  /// and the signup band the footer's "Newsletter" link points at.
  library
  /// The signup band on /articles and at the end of an article.
  article
  /// Historical. The footer carried the signup block until 2026-09-16, when it
  /// moved to a band of its own; no surface writes this value any more, and no
  /// row ever carried it.
  footer
}

model Subscriber {
  id             String           @id @default(uuid())
  email          String           @unique @db.Citext
  locale         Locale           @default(ro)
  source         SubscriberSource
  consentAt      DateTime
  consentVersion String
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime         @default(now())

  @@index([createdAt])
}

// --- Deliverable orders (group C: personalized menus + protocols, brief §2) ---
//
// One-off products rather than appointments or subscriptions: the visitor picks
// a product on /pricing, sends a short form, and receives a written result. So
// the order has to record WHICH product was ordered — that is the whole point
// of the record, and it is why these do not fit `Subscription` or
// `QuickQuestion`.
//
// `product` is an enum and `titleRo`/`priceEur` are stamped server-side from
// `DeliverableCatalog` below. Nothing about what was bought, or what it costs,
// is taken from the request body: a public form must not be able to name its
// own price.

/// What the five group-C products are called and what they cost, edited in the
/// back office (`docs/shape-deliverable-catalog.md`, approved 2026-09-16). It
/// replaces `DELIVERABLE_CATALOG`, a constant in packages/shared that could
/// only be changed by a deployment.
///
/// Keyed by the enum, like `SiteMedia` is keyed by its slot: there are exactly
/// five rows, they are never created or deleted, and no surrogate id would be
/// referenced by anything. `DeliverableOrder` deliberately has no foreign key
/// to this table — its `product` column is already the same enum, so the
/// constraint would add nothing, and it would force the five rows into a
/// migration instead of the seed.
model DeliverableCatalog {
  code      DeliverableProduct @id
  /// Price in whole EUR. `0` means "on request" here as it does everywhere
  /// else in this schema, and refuses a checkout rather than selling for free.
  priceEur  Int
  /// All three are required: we write these five ourselves and they are not
  /// the client's own copy, which is what R3 makes `*Ru` nullable for.
  titleRo   String
  titleEn   String
  titleRu   String
  sortOrder Int                @default(0)
  /// Withdrawn from sale. The public endpoint filters on it, so no reader has
  /// to remember to (audit A4).
  active    Boolean            @default(true)

  updatedAt DateTime @updatedAt
}

model DeliverableOrder {
  id      String             @id @default(uuid())
  product DeliverableProduct
  /// Romanian label and price at the moment of ordering, copied from
  /// `DeliverableCatalog`. Kept on the row so a later price change does not
  /// rewrite history.
  titleRo String
  priceEur Int

  clientName  String
  clientEmail String
  phone       String?
  /// Free-text detail from the order form (allergies, goals, age of the child).
  notes       String?
  locale      Locale  @default(ro)

  status        DeliverableOrderStatus @default(new)
  paymentStatus PaymentStatus          @default(pending)
  /// Set once when the finished menu/protocol has been sent to the client.
  deliveredAt   DateTime?

  /// The dossier this order belongs to, once somebody links it. Optional
  /// because an order arrives from the public form long before a medical
  /// record exists, and `SetNull` because erasing the patient must not delete
  /// the accounting trail of what was sold. Added by audit A5 (F12): this was
  /// the one lead kind with no patient relation at all, so a group-C order
  /// never appeared in the dossier and could not be linked to one.
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  patientId String?

  uploadLinks UploadLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([patientId])
}

// --- Working hours (client answers v2 §11.5) ---
//
// The EXPRESS question promises an answer in ~1 hour "during working hours",
// so the countdown has to know when those are. A question sent at 23:40 on a
// Saturday is not late at 00:40 on Sunday.
//
// Editable in the back office rather than an env var, because a schedule is
// something the doctor changes — holidays, a week off, moving the afternoon —
// and every one of those would otherwise be a deploy.
//
// Singleton: one row, like AboutPage.

model WorkingHours {
  /// Always the literal "singleton". A `@default(uuid())` here meant nothing
  /// in the database enforced "one row", and the create-on-first-read path
  /// raced itself: two concurrent public GETs both found nothing and both
  /// inserted, after which the service read whichever `findFirst` returned
  /// (audit A5, F4). A fixed primary key makes the second writer an upsert.
  id String @id

  /// IANA zone. The arithmetic is done in this zone, so DST is handled by the
  /// clock the patient and the doctor actually read.
  timezone String @default("Europe/Chisinau")

  /// Seven entries, Monday first:
  /// `{ weekday: 1..7, closed: boolean, opensAt: "09:00", closesAt: "17:00" }`.
  /// JSON rather than seven columns because it is read and written whole, and
  /// a day is never queried on its own.
  days Json

  /// The EXPRESS promise, in working minutes. Data, not a constant: "~1 oră"
  /// is the client's current wording and she may revise it.
  expressSlaMinutes Int @default(60)

  /// ⚠ True until the doctor confirms these are really her hours. The seeded
  /// schedule is a placeholder — the client still owes us the real one — and
  /// the back office says so loudly while this is set.
  isPlaceholder Boolean @default(true)

  updatedAt DateTime @updatedAt
}

// --- Patient uploads (client answers v2 §11.14) ---
//
// Patients send analyses and investigations BEFORE the consultation. There are
// no patient accounts and building them is a different project, so access is a
// capability: one expiring link, scoped to one appointment or one order, that
// grants upload and nothing else. No login, no reading of anyone else's data,
// no access to the rest of the portal.
//
// The token is stored in the clear rather than hashed, deliberately: the doctor
// has to be able to re-send the same link days later from the back office, and
// what it can do — add files to one appointment until it expires — is a much
// smaller capability than what already sits in this table's neighbours. The
// files themselves live in PRIVATE storage and are never reachable by URL.
//
// One primitive for both surfaces, as §11.14 asks: an appointment needs it for
// analyses, a group-C order needs it for the documents a protocol is built
// from.

model UploadLink {
  id     String           @id @default(uuid())
  /// The URL is the only credential. High-entropy, opaque, single-purpose.
  ///
  /// Stored in the clear, deliberately (audit 2026-09-10, finding 7): the back
  /// office has to be able to hand the doctor the same link again days later,
  /// and a hash cannot do that. What the token opens is narrow — see your own
  /// filenames, add a file, delete one — and never the bytes of a stored
  /// document. Revisit when backups go off-site: that is the point at which a
  /// leaked dump becomes the likelier threat, and the answer there is an
  /// encrypted dump as much as a hashed column.
  token  String           @unique
  target UploadLinkTarget

  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId String?
  order         DeliverableOrder? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String?

  /// Who the link was issued to — shown on the upload page so a patient can
  /// tell at a glance that they opened the right one.
  clientName  String
  clientEmail String

  expiresAt DateTime
  /// Set the first time the patient ticks the consent box. Uploading medical
  /// data is not implied by clicking a link, so nothing is stored before this.
  consentAt DateTime?
  /// Which consent wording they agreed to, so a later change to the text does
  /// not silently rewrite what was consented to.
  consentVersion String?
  /// Set when the doctor withdraws the link early.
  revokedAt DateTime?

  documents UploadedDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appointmentId])
  @@index([orderId])
  @@index([expiresAt])
}

model UploadedDocument {
  id     String     @id @default(uuid())
  link   UploadLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  linkId String

  /// Opaque key in PRIVATE_STORAGE_DIR — never a public URL.
  fileKey  String
  /// The patient's own filename, kept for the doctor's download.
  fileName String
  mimeType String
  sizeBytes Int

  /// Free-text note the patient may add ("analize din 12 mai").
  note String?

  uploadedAt DateTime @default(now())

  @@index([linkId])
  @@index([uploadedAt])
}

// --- About (singleton) ---

model AboutPage {
  /// Always the literal "singleton" — same reason as WorkingHours.id.
  id        String   @id
  titleRo   String
  titleEn   String
  titleRu   String?
  contentRo String
  contentEn String
  contentRu String?
  images    Json?
  // Structured, client-editable page blocks (JSON arrays of localized items).
  // The `*Ru` keys are optional inside the JSON too — rows written before RU
  // existed simply lack them, and readers fall back to RO.
  stats        Json? // [{ value, labelRo, labelEn, labelRu? }]
  credentials  Json? // [{ ro, en, ru? }]
  // NOTE: `faq` and `testimonials` used to live here as JSON blocks. Both were
  // dropped in favour of the models above — FAQ because the block rendered
  // nowhere, testimonials because the block was still serving the fabricated
  // placeholder reviews that the frontend had already been cleaned of.
  updatedAt DateTime @updatedAt
}

// --- Patients / medical records (module_patients.md) ---

enum PatientEntryType {
  anamnesis
  note
  prescription
  document
}

/// What a payment was for. `targetId` points at the row of that kind.
enum PaymentTargetType {
  appointment
  quick_question
  deliverable_order
  subscription
  material
}

/// Our own normalized payment lifecycle. Deliberately NOT maib's strings:
/// the bank returns inconsistent casing (`Waitingforinit` vs the documented
/// `WaitingForInit`) and undocumented values (`Refunded`), so everything is
/// mapped through `toPaymentState()` on the way in.
enum PaymentState {
  created
  pending
  paid
  failed
  expired
  abandoned
  cancelled
  refunded
  partially_refunded
}

enum RefundState {
  created
  accepted
  failed
}

model Patient {
  id        String    @id @default(uuid())
  fullName  String
  email     String    @unique @db.Citext // dedup / link key
  phone     String?
  birthDate DateTime?
  gender    String? // 'male' | 'female' | 'other' | null
  notes     String? // non-medical admin notes
  consentAt DateTime? // GDPR consent timestamp
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  entries           PatientEntry[]
  appointments      Appointment[]
  subscriptions     Subscription[]
  quickQuestions    QuickQuestion[]
  deliverableOrders DeliverableOrder[]
  payments          Payment[]
}

model PatientEntry {
  id         String           @id @default(uuid())
  patient    Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId  String
  type       PatientEntryType
  title      String?
  body       String? // markdown (anamnesis/note/prescription text)
  fileUrl    String? // document/prescription PDF — authenticated url
  fileName   String?
  occurredAt DateTime         @default(now()) // clinical date (editable)
  authorId   String? // User who wrote it
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([patientId, occurredAt])
}

/// One maib checkout session and the payment that completed it.
///
/// This is the ledger: the bank's list endpoints are broken (see
/// docs/payments-maib-checkout.md §14), so an id we fail to store here is a
/// payment we can never look up again. Every field the bank gives us is kept.
model Payment {
  id String @id @default(uuid())

  /// maib session id — also the idempotency key for the callback. Null on a
  /// payment that never went through the bank: a manual payment recorded in
  /// the back office is a `Payment` row like any other, and it has no checkout
  /// session behind it (audit A5, F3).
  checkoutId String? @unique
  /// maib payment id (`payId`). Absent until the payer actually pays.
  paymentId  String? @unique
  /// Our own order reference, sent as `orderInfo.id` and echoed back.
  orderId    String  @unique
  /// The buyer's own idea of "this purchase", minted by the checkout page and
  /// kept in sessionStorage. A second submit of the same form — a double click,
  /// a back button, a reload — finds this row and is handed the checkout URL it
  /// already has, instead of opening a second session and a second ticket.
  intentKey  String? @unique
  /// The bank's hosted page for this session. Stored because maib returns it
  /// exactly once, in the response to `POST /v2/checkouts`, and `GET
  /// /v2/checkouts/{id}` does not carry it — so without this column an
  /// `intentKey` that is supposed to hand back "the same checkout" has nothing
  /// to hand back. Never leaves the API on a read route: it is a live link to
  /// a card form.
  checkoutUrl String?

  state    PaymentState @default(created)
  amount   Decimal      @db.Decimal(12, 2)
  currency String
  /// `Card` | `MiaQr` | … Captured at payment time on purpose: maib blanks
  /// it out on the payment record once a refund is accepted.
  method   String?

  /// What was bought. Polymorphic because one payment flow serves
  /// appointments, EXPRESS questions, deliverables and paid materials.
  targetType PaymentTargetType
  targetId   String?

  /// The payer, as given to the bank. Kept even when no Patient exists yet —
  /// a payer is not automatically a medical record.
  payerName  String?
  payerEmail String
  payerPhone String?

  /// Linked when a Patient with this email already exists. History lookups
  /// also match on `payerEmail`, so a patient created later still sees
  /// everything they paid for.
  patient   Patient? @relation(fields: [patientId], references: [id])
  patientId String?

  /// Bank references, for reconciliation and support tickets.
  rrn           String?
  approvalCode  String?
  cardMask      String?
  threeDsResult String?
  terminalId    String?

  refundedAmount Decimal @default(0) @db.Decimal(12, 2)

  /// Verbatim last callback payload — the audit trail for a disputed charge.
  rawCallback Json?

  /// Why a manual payment was recorded, in the operator's own words: "cash la
  /// cabinet", "transfer bancar 12.09". A payment the bank never saw has no
  /// references of its own, so this is the only evidence of what happened
  /// (audit A5, F3). Null on everything that came through the checkout.
  note String?
  /// Who recorded or voided a manual payment. Same shape as PaymentRefund.
  authorId String?

  expiresAt DateTime?
  paidAt    DateTime?
  failedAt  DateTime?
  /// When the bank's required payment confirmation left. Null means it did not:
  /// with no SMTP nothing is delivered, and the back office shows the payment as
  /// unconfirmed with a resend action rather than claiming a receipt was sent.
  confirmationSentAt DateTime?

  refunds   PaymentRefund[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([state])
  @@index([patientId])
  @@index([payerEmail])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model PaymentRefund {
  id String @id @default(uuid())

  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId String

  /// maib refund id. Null until the bank answers: the row is written first, so
  /// a refund that is in flight still counts against the remaining balance.
  refundId String?     @unique
  state    RefundState @default(created)
  amount   Decimal     @db.Decimal(12, 2)
  currency String
  /// `Full` | `Partial`, as reported by maib.
  kind     String?
  reason   String

  /// Who pressed the button in the back office.
  authorId String?

  executedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([paymentId])
}
