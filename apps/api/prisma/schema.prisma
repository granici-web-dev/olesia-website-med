// Prisma schema — olesia-website-med backend.
// Enums mirror packages/shared/src/lib/enums.ts (keep them in sync).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---

enum Role {
  admin
  editor
}

enum ServiceCode {
  pediatric
  nutrition
  integrative
  monitoring
  quick_question
}

enum ServiceGroup {
  A_booking
  B_portal
}

enum AppointmentStatus {
  scheduled
  canceled
  completed
  no_show
}

enum PaymentStatus {
  pending
  confirmed
}

enum PostStatus {
  draft
  published
}

enum ContactType {
  phone
  email
  address
  social
  other
}

enum SubscriptionStatus {
  active
  paused
  expired
  canceled
}

enum QuickQuestionStatus {
  open
  answered
  closed
}

// --- Back-office users ---

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(editor)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts Post[]
}

// --- Service catalog (5 services) ---

model Service {
  id                   String       @id @default(uuid())
  code                 ServiceCode  @unique
  group                ServiceGroup
  titleRo              String
  titleEn              String
  descriptionRo        String
  descriptionEn        String
  durationMin          Int?
  price                Int
  priceLabelRo         String?
  priceLabelEn         String?
  calendlyEventTypeUri String?      @unique // API event_type URI (webhook mapping)
  calendlySchedulingUrl String?     // public booking link for the site embed
  sortOrder            Int          @default(0)
  active               Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  appointments  Appointment[]
  subscriptions Subscription[]
}

// --- Appointments (group A, Calendly) ---

model Appointment {
  id               String            @id @default(uuid())
  service          Service           @relation(fields: [serviceId], references: [id])
  serviceId        String
  calendlyEventUri String            @unique // idempotency key
  clientName       String
  clientEmail      String
  reason           String?
  startTime        DateTime
  endTime          DateTime
  videoUrl         String?
  status           AppointmentStatus @default(scheduled)
  paymentStatus    PaymentStatus     @default(pending)
  cancelUrl        String?
  rescheduleUrl    String?
  prepSentAt       DateTime?
  planUrl          String? // written plan uploaded by the specialist
  planUploadedAt   DateTime?
  patient          Patient?          @relation(fields: [patientId], references: [id])
  patientId        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([serviceId])
  @@index([status])
  @@index([startTime])
  @@index([patientId])
}

// --- Subscriptions (service 04) ---

model Subscription {
  id                 String             @id @default(uuid())
  service            Service            @relation(fields: [serviceId], references: [id])
  serviceId          String
  clientName         String
  clientEmail        String
  phone              String? // lead contact phone (public intake)
  notes              String? // free-text message from the public lead form
  status             SubscriptionStatus @default(active)
  paymentStatus      PaymentStatus      @default(pending)
  videoQuotaPerMonth Int                @default(2)
  videoQuotaUsed     Int                @default(0)
  startsAt           DateTime
  endsAt             DateTime
  patient            Patient?           @relation(fields: [patientId], references: [id])
  patientId          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([serviceId])
  @@index([status])
  @@index([patientId])
}

// --- Quick questions (service 05) ---

model QuickQuestion {
  id            String              @id @default(uuid())
  clientName    String
  clientEmail   String
  phone         String? // lead contact phone (public intake)
  question      String
  attachments   String[]
  answer        String?
  status        QuickQuestionStatus @default(open)
  paymentStatus PaymentStatus       @default(pending)
  dueAt         DateTime // 48h SLA deadline
  answeredAt    DateTime?
  patient       Patient?            @relation(fields: [patientId], references: [id])
  patientId     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status])
  @@index([patientId])
}

// --- Blog ---

model Category {
  id     String @id @default(uuid())
  slug   String @unique
  nameRo String
  nameEn String

  posts Post[]
}

model Post {
  id            String     @id @default(uuid())
  slug          String     @unique
  titleRo       String
  titleEn       String
  excerptRo     String?
  excerptEn     String?
  contentRo     String
  contentEn     String
  coverImageUrl String?
  status        PostStatus @default(draft)
  publishedAt   DateTime?
  author        User       @relation(fields: [authorId], references: [id])
  authorId      String
  categories    Category[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status])
  @@index([authorId])
}

// --- Contacts ---

model Contact {
  id        String      @id @default(uuid())
  type      ContactType
  labelRo   String
  labelEn   String
  value     String
  sortOrder Int         @default(0)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

// --- About (singleton) ---

model AboutPage {
  id        String   @id @default(uuid())
  titleRo   String
  titleEn   String
  contentRo String
  contentEn String
  images    Json?
  // Structured, client-editable page blocks (JSON arrays of localized items):
  stats        Json? // [{ value, labelRo, labelEn }]
  credentials  Json? // [{ ro, en }]
  testimonials Json? // [{ quoteRo, quoteEn, author, roleRo, roleEn }]
  faq          Json? // [{ qRo, qEn, aRo, aEn }]
  updatedAt DateTime @updatedAt
}

// --- Patients / medical records (module_patients.md) ---

enum PatientEntryType {
  anamnesis
  note
  prescription
  document
}

model Patient {
  id        String    @id @default(uuid())
  fullName  String
  email     String    @unique // dedup / link key
  phone     String?
  birthDate DateTime?
  gender    String? // 'male' | 'female' | 'other' | null
  notes     String? // non-medical admin notes
  consentAt DateTime? // GDPR consent timestamp
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  entries        PatientEntry[]
  appointments   Appointment[]
  subscriptions  Subscription[]
  quickQuestions QuickQuestion[]
}

model PatientEntry {
  id         String           @id @default(uuid())
  patient    Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId  String
  type       PatientEntryType
  title      String?
  body       String? // markdown (anamnesis/note/prescription text)
  fileUrl    String? // document/prescription PDF — authenticated url
  fileName   String?
  occurredAt DateTime         @default(now()) // clinical date (editable)
  authorId   String? // User who wrote it
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([patientId, occurredAt])
}
