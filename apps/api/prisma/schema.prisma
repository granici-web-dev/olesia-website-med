// Prisma schema — olesia-website-med backend.
// Enums mirror packages/shared/src/lib/enums.ts (keep them in sync).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---

enum Role {
  admin
  editor
}

enum ServiceCode {
  pediatric
  // Nutrition is two services, split by audience (brief §1). Same length and
  // price; different Calendly event types, which is what the webhook routes on.
  nutrition_copii
  nutrition_adulti
  integrative
  monitoring
  quick_question
  free_consult
}

enum ServiceGroup {
  A_booking
  B_portal
}

enum AppointmentStatus {
  scheduled
  canceled
  completed
  no_show
}

enum PaymentStatus {
  pending
  confirmed
}

enum PostStatus {
  draft
  published
}

enum ContactType {
  phone
  email
  address
  social
  other
}

enum SubscriptionStatus {
  active
  paused
  expired
  canceled
}

enum QuickQuestionStatus {
  open
  answered
  closed
}

enum ContactMessageStatus {
  new
  read
  replied
}

enum DeliverableProduct {
  menu_7
  menu_14
  menu_30
  protocol_pednutri
  protocol_complementary
}

enum DeliverableOrderStatus {
  new
  in_progress
  delivered
  canceled
}

// --- Back-office users ---

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(editor)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // --- Two-factor authentication (TOTP), client answers v2 §10 ---
  /// Base32 TOTP secret. Present from the moment enrolment starts; only
  /// `totpEnabled` decides whether it is actually required at login.
  totpSecret       String?
  totpEnabled      Boolean  @default(false)
  totpEnabledAt    DateTime?
  /// Argon2 hashes of single-use recovery codes — never the codes themselves,
  /// so a database leak cannot be used to bypass the second factor.
  totpRecoveryCodes String[] @default([])

  posts Post[]
}

// --- Service catalog (5 services) ---
//
// Every content model carries three locales. RO and EN are required (the site
// launched bilingual); RU is nullable because the existing rows predate it and
// because a half-translated page must still save. Readers fall back RU → RO,
// so a missing translation degrades to Romanian instead of an empty screen.

model Service {
  id                   String       @id @default(uuid())
  code                 ServiceCode  @unique
  group                ServiceGroup
  titleRo              String
  titleEn              String
  titleRu              String?
  descriptionRo        String
  descriptionEn        String
  descriptionRu        String?
  durationMin          Int?
  price                Int
  priceLabelRo         String?
  priceLabelEn         String?
  priceLabelRu         String?
  calendlyEventTypeUri String?      @unique // API event_type URI (webhook mapping)
  calendlySchedulingUrl String?     // public booking link for the site embed
  sortOrder            Int          @default(0)
  active               Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  appointments  Appointment[]
  subscriptions Subscription[]
}

// --- Appointments (group A, Calendly) ---

model Appointment {
  id               String            @id @default(uuid())
  service          Service           @relation(fields: [serviceId], references: [id])
  serviceId        String
  calendlyEventUri String            @unique // idempotency key
  clientName       String
  clientEmail      String
  reason           String?
  startTime        DateTime
  endTime          DateTime
  videoUrl         String?
  status           AppointmentStatus @default(scheduled)
  paymentStatus    PaymentStatus     @default(pending)
  cancelUrl        String?
  rescheduleUrl    String?
  prepSentAt       DateTime?
  planText         String? // written treatment plan typed by the specialist
  planFileKey      String? // PRIVATE storage key of an optional attachment (rx/doc)
  planFileName     String? // original filename of the attachment, for download
  planUploadedAt   DateTime?
  patient          Patient?          @relation(fields: [patientId], references: [id])
  patientId        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([serviceId])
  @@index([status])
  @@index([startTime])
  @@index([patientId])
}

// --- Subscriptions (service 04) ---

model Subscription {
  id                 String             @id @default(uuid())
  service            Service            @relation(fields: [serviceId], references: [id])
  serviceId          String
  clientName         String
  clientEmail        String
  phone              String? // lead contact phone (public intake)
  notes              String? // free-text message from the public lead form
  status             SubscriptionStatus @default(active)
  paymentStatus      PaymentStatus      @default(pending)
  videoQuotaPerMonth Int                @default(2)
  videoQuotaUsed     Int                @default(0)
  startsAt           DateTime
  endsAt             DateTime
  patient            Patient?           @relation(fields: [patientId], references: [id])
  patientId          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([serviceId])
  @@index([status])
  @@index([patientId])
}

// --- Quick questions (service 05) ---

model QuickQuestion {
  id            String              @id @default(uuid())
  clientName    String
  clientEmail   String
  phone         String? // lead contact phone (public intake)
  question      String
  /// Same reason as `Post.ageKeys`: an absent default reads back as
  /// `undefined` on any row that predates the column.
  attachments   String[]            @default([])
  answer        String?
  status        QuickQuestionStatus @default(open)
  paymentStatus PaymentStatus       @default(pending)
  dueAt         DateTime // 48h SLA deadline
  answeredAt    DateTime?
  patient       Patient?            @relation(fields: [patientId], references: [id])
  patientId     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status])
  @@index([patientId])
}

// --- Blog ---

model Category {
  id     String @id @default(uuid())
  slug   String  @unique
  nameRo String
  nameEn String
  nameRu String?

  posts Post[]
}

model Post {
  id            String     @id @default(uuid())
  slug          String     @unique
  titleRo       String
  titleEn       String
  titleRu       String?
  excerptRo     String?
  excerptEn     String?
  excerptRu     String?
  contentRo     String
  contentEn     String
  contentRu     String?
  coverImageUrl String?

  /// Keys from the shared child-age taxonomy ('0-6m', '6-12m', …) — the same
  /// one the digital library uses, so one filter covers both surfaces. Empty
  /// means the article is not age-specific, and the age filter always shows it.
  ///
  /// `@default([])` is load-bearing, not decoration: without it the column is
  /// NULL for every row written before this field existed, Prisma reads that
  /// back as `undefined`, and the key silently disappears from the API
  /// response — leaving the public age filter iterating over nothing.
  ageKeys       String[] @default([])

  status        PostStatus @default(draft)
  publishedAt   DateTime?
  author        User       @relation(fields: [authorId], references: [id])
  authorId      String
  categories    Category[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status])
  @@index([authorId])
}

// --- Contacts ---

model Contact {
  id        String      @id @default(uuid())
  type      ContactType
  labelRo   String
  labelEn   String
  labelRu   String?
  value     String
  sortOrder Int         @default(0)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

// --- Site media (hero video, poster, page portraits) ---
//
// A fixed set of SLOTS, not a gallery: each page asks for one specific picture
// and the homepage for one video per locale, so the catalogue of keys lives in
// code (`packages/shared`) and only the file behind each key is editable.
//
// A row here is an OVERRIDE. With no row the site serves the asset committed
// under `apps/frontend/public/assets/`, which is also why swapping a file no
// longer needs the "give it a new filename" trick: every upload lands on a
// fresh UUID URL, so no cache anywhere is holding the old bytes.

model SiteMedia {
  /// Slot key from `SITE_MEDIA_SLOTS`, e.g. `hero_video_ro`, `portrait_about`.
  key      String  @id
  url      String
  /// Intrinsic size — `next/image` needs it for photos; null for video.
  width    Int?
  height   Int?
  /// Original filename, so the back office can show what was uploaded.
  fileName String?

  updatedAt DateTime @updatedAt
}

// --- Biblioteca digitală (downloadable materials, /guides) ---

enum MaterialAccess {
  free
  paid
}

/// Merchandising badges on a material card.
enum MaterialFlag {
  recommended
  popular
  new
}

model MaterialCategory {
  id        String  @id @default(uuid())
  slug      String  @unique
  nameRo    String
  nameEn    String
  nameRu    String?
  sortOrder Int     @default(0)

  materials Material[]
}

model Material {
  id         String           @id @default(uuid())
  slug       String           @unique
  category   MaterialCategory @relation(fields: [categoryId], references: [id])
  categoryId String

  /// Keys from the shared child-age taxonomy ('0-6m', '6-12m', …). Empty means
  /// the material is not age-specific, and the age filter always shows it.
  /// See `Post.ageKeys` for why the default is spelled out.
  ageKeys String[] @default([])

  titleRo       String
  titleEn       String
  titleRu       String?
  descriptionRo String
  descriptionEn String
  descriptionRu String?

  /// Page count and language of the file, rendered as "PDF · 16 pag. · RO".
  /// Stored as data rather than three hand-written strings, so the units follow
  /// the visitor's locale.
  pageCount Int?
  fileLang  String?

  access MaterialAccess @default(free)
  /// Whole EUR, paid materials only. Selling them needs the payments module —
  /// until it exists the storefront routes a purchase to the contact page.
  price  Int?
  flags  MaterialFlag[]

  /// Public URL of the uploaded PDF. Null while the file is still missing: the
  /// storefront then shows the card as "în curând" instead of a dead download.
  fileUrl  String?
  fileName String?

  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
  @@index([categoryId])
}

// --- Media appearances (the /media page) ---

enum MediaKind {
  tv
  radio
  conference
  press
}

enum MediaEmbedProvider {
  youtube
  facebook
}

// Recordings are NEVER self-hosted: broadcast rights belong to the channel and
// the files run 30–170 MB. Every item points at its original publication and is
// embedded from there, click-to-load, so the third-party iframe only appears
// after the visitor presses play. The thumbnail, by contrast, IS stored locally
// — calling ytimg/fbcdn on first paint would re-introduce exactly the
// pre-consent third-party request the click-to-load embed avoids.

model MediaAppearance {
  id       String    @id @default(uuid())
  kind     MediaKind
  /// Broadcaster, e.g. "Moldova 1".
  outlet   String
  /// Programme name, e.g. "Bună dimineața".
  show     String?
  /// Broadcast date. Null when the source never published one — the site then
  /// simply omits it rather than guessing.
  date     DateTime?
  /// Runtime as published, "mm:ss".
  duration String?

  titleRo   String
  titleEn   String
  titleRu   String?
  summaryRo String
  summaryEn String
  summaryRu String?

  /// Canonical publication URL — always offered as an outbound link.
  url           String
  embedProvider MediaEmbedProvider
  /// YouTube video id, or the canonical Facebook video permalink.
  embedRef      String

  thumbUrl    String
  thumbWidth  Int
  thumbHeight Int

  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

// --- Testimonials (parent reviews, homepage) ---
//
// Real reviews only. The site has already shipped invented ones twice, so the
// model is shaped to make fabrication awkward: `author` is nullable because an
// unsigned review is a real case, and the site answers it with a localized
// neutral label rather than a name someone made up. `source` records the
// platform a review came from when it came from one.

model Testimonial {
  id      String  @id @default(uuid())
  quoteRo String
  quoteEn String
  quoteRu String?
  /// Null when the reviewer did not sign. Names are never translated, so this
  /// is a single field — the neutral stand-in is UI copy, not data.
  author  String?
  /// Short context under the name ("mamă, Chișinău"). Optional: many reviews
  /// arrive with nothing but the text.
  roleRo  String?
  roleEn  String?
  roleRu  String?
  /// Platform the review was left on, e.g. "DoctorChat" — attribution the
  /// client may be required to display.
  source    String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

// --- FAQ (the public /faq page) ---
//
// Two levels, because the page is built that way: a category is a section with
// its own anchor (`slug` → `/faq#programare`, used by the sticky nav and by
// deep links from the service pages), and the items are the question/answer
// pairs inside it. Rows rather than one JSON blob, so a single question can be
// reordered or hidden without rewriting the others — and so the FAQPage
// JSON-LD is generated from what is actually published.

model FaqCategory {
  id        String   @id @default(uuid())
  /// URL anchor, derived from the Romanian title when the category is created
  /// and never re-derived afterwards: renaming a section must not break links
  /// that are already out there.
  slug      String   @unique
  titleRo   String
  titleEn   String
  titleRu   String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items FaqItem[]
}

model FaqItem {
  id         String      @id @default(uuid())
  category   FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  questionRo String
  questionEn String
  questionRu String?
  answerRo   String
  answerEn   String
  answerRu   String?
  sortOrder  Int         @default(0)
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([categoryId, sortOrder])
}

// --- Contact-form messages (public Contact page → back-office "Mesaje") ---
//
// Non-medical messages submitted from the site's Contact form. The doctor
// reads them in the back office, marks them read and (once SMTP is wired)
// replies by email — `reply`/`repliedAt` are reserved for that next step.

model ContactMessage {
  id        String               @id @default(uuid())
  name      String
  email     String
  subject   String // ContactSubject value: appointment | payment | how_it_works | other
  message   String
  status    ContactMessageStatus @default(new)
  readAt    DateTime?
  reply     String? // email reply text (set when answered from the portal)
  repliedAt DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status])
  @@index([createdAt])
}

// --- Deliverable orders (group C: personalized menus + protocols, brief §2) ---
//
// One-off products rather than appointments or subscriptions: the visitor picks
// a product on /pricing, sends a short form, and receives a written result. So
// the order has to record WHICH product was ordered — that is the whole point
// of the record, and it is why these do not fit `Subscription` or
// `QuickQuestion`.
//
// `product` is an enum and `titleRo`/`priceEur` are stamped server-side from
// `DELIVERABLE_CATALOG` in packages/shared. Nothing about what was bought, or
// what it costs, is taken from the request body: a public form must not be able
// to name its own price.

model DeliverableOrder {
  id      String             @id @default(uuid())
  product DeliverableProduct
  /// Romanian label and price at the moment of ordering, copied from the shared
  /// catalog. Kept on the row so a later price change does not rewrite history.
  titleRo String
  priceEur Int

  clientName  String
  clientEmail String
  phone       String?
  /// Free-text detail from the order form (allergies, goals, age of the child).
  notes       String?

  status        DeliverableOrderStatus @default(new)
  paymentStatus PaymentStatus          @default(pending)
  /// Set once when the finished menu/protocol has been sent to the client.
  deliveredAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// --- About (singleton) ---

model AboutPage {
  id        String   @id @default(uuid())
  titleRo   String
  titleEn   String
  titleRu   String?
  contentRo String
  contentEn String
  contentRu String?
  images    Json?
  // Structured, client-editable page blocks (JSON arrays of localized items).
  // The `*Ru` keys are optional inside the JSON too — rows written before RU
  // existed simply lack them, and readers fall back to RO.
  stats        Json? // [{ value, labelRo, labelEn, labelRu? }]
  credentials  Json? // [{ ro, en, ru? }]
  // NOTE: `faq` and `testimonials` used to live here as JSON blocks. Both were
  // dropped in favour of the models above — FAQ because the block rendered
  // nowhere, testimonials because the block was still serving the fabricated
  // placeholder reviews that the frontend had already been cleaned of.
  updatedAt DateTime @updatedAt
}

// --- Patients / medical records (module_patients.md) ---

enum PatientEntryType {
  anamnesis
  note
  prescription
  document
}

model Patient {
  id        String    @id @default(uuid())
  fullName  String
  email     String    @unique // dedup / link key
  phone     String?
  birthDate DateTime?
  gender    String? // 'male' | 'female' | 'other' | null
  notes     String? // non-medical admin notes
  consentAt DateTime? // GDPR consent timestamp
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  entries        PatientEntry[]
  appointments   Appointment[]
  subscriptions  Subscription[]
  quickQuestions QuickQuestion[]
}

model PatientEntry {
  id         String           @id @default(uuid())
  patient    Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId  String
  type       PatientEntryType
  title      String?
  body       String? // markdown (anamnesis/note/prescription text)
  fileUrl    String? // document/prescription PDF — authenticated url
  fileName   String?
  occurredAt DateTime         @default(now()) // clinical date (editable)
  authorId   String? // User who wrote it
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([patientId, occurredAt])
}
