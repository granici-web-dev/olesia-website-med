# --- apps/api environment ---
# Copy to apps/api/.env and fill in. Never commit the real .env.

# Server
PORT=3333
# Comma-separated allowed origins (frontend + back office)
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# Database (PostgreSQL)
DATABASE_URL="postgresql://olesia:olesia@localhost:5432/olesia?schema=public"

# Auth — JWT (access + refresh). The API refuses to start unless both are set,
# at least 32 characters, and different from each other. Generate real ones for
# anything but local dev: `openssl rand -base64 48`.
JWT_ACCESS_SECRET=dev-access-secret-not-for-any-real-deployment
JWT_REFRESH_SECRET=dev-refresh-secret-not-for-any-real-deployment
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# `Secure` on the refresh cookie. Leave it alone in production; set it to false
# only for local HTTP development.
COOKIE_SECURE=false

# Calendly (group A booking). Map services by event_type URI only.
CALENDLY_API_TOKEN=
CALENDLY_ORG_URI=
CALENDLY_WEBHOOK_SIGNING_KEY=

# maib e-Commerce Checkout. Credentials come from ecom@maib.md — the sandbox set
# first, production only after the contract is signed. See
# docs/payments-maib-checkout.md for the flow and the open questions.
# Base URL: https://sandbox.maibmerchants.md | https://api.maibmerchants.md
MAIB_BASE_URL=https://sandbox.maibmerchants.md
MAIB_CLIENT_ID=
MAIB_CLIENT_SECRET=
# Signs the back-channel callback: HMAC-SHA256 over `{rawBody}.{timestamp}`,
# base64. Note the argument order differs from the Calendly webhook above.
MAIB_SIGNATURE_KEY=
# Testing affordance only. The catalog quotes EUR and production charges EUR;
# this exists because the sandbox merchant profile does not have EUR enabled,
# so the end-to-end run against the bank has to go through in MDL. Set in
# production and it is ignored, with a warning.
# PAYMENT_CURRENCY=MDL

# --- The registered entity behind the practice ---
# Named on /gdpr, /terms and on the bank's payment confirmation email, all from
# here so the three cannot disagree. NOT required at boot: the client's
# incorporation does not exist yet and the rest of the site is not blocked on
# it. While these are empty the legal pages show their draft banner and the
# EXPRESS checkout answers 503 legal_entity_missing.
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_IDNO=
LEGAL_ENTITY_ADDRESS=

# File storage (local for now, behind the storage abstraction)
UPLOADS_DIR=./uploads
# Browser-facing API origin used to build uploaded-image URLs.
# Local dev defaults to http://localhost:<PORT>; set to the public domain in prod.
PUBLIC_API_URL=http://localhost:3333

# Spam protection (answers v2 §10) — Google reCAPTCHA v3 server secret, paired
# with NEXT_PUBLIC_RECAPTCHA_SITE_KEY on the frontend. LEAVE EMPTY and token
# verification is skipped entirely, so local dev works without keys.
RECAPTCHA_SECRET=
# Score below which a submission is treated as a bot (Google's suggested 0.5).
# RECAPTCHA_MIN_SCORE=0.5

# --- Patient document uploads (client answers v2 §11.14) ---
# Public site origin, used to build the upload link handed to the patient.
# It must be the SITE's origin, not the API's — the link opens a page.
PUBLIC_SITE_URL=http://localhost:3000
# Private storage for medical files. Deliberately outside UPLOADS_DIR so the
# public static route can never serve them. Mount a volume here in production.
PRIVATE_UPLOADS_DIR=./private-uploads
# How long an upload link accepts files before it stops working.
UPLOAD_LINK_TTL_DAYS=30
# ⚠ PLACEHOLDER — the client and their lawyer still owe us the real medical-data
# retention period. The purge job deletes files (row + bytes) once past it.
MEDICAL_UPLOAD_RETENTION_DAYS=180
# Cap per link. Enough for a full set of analyses, not an upload host.
UPLOAD_MAX_FILES=15
