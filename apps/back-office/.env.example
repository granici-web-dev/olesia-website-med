# Back office (Vite) environment.

# Base URL of the NestJS API. Default: /api (same-origin; proxy in prod/nginx).
VITE_API_URL=/api

# Data source. Anything other than "false" keeps the in-memory mocks (so the
# app runs without a backend). Set to false once the API endpoints are live.
VITE_API_MOCKS=true
