# Back office (Vite) environment.

# Base URL of the NestJS API. Default: /api (same-origin; proxy in prod/nginx).
# Keep the panel and the API on one origin — the refresh cookie is SameSite=Lax,
# and that is the whole CSRF defence (see docs/deployment.md).
VITE_API_URL=/api

# Data source. Set to exactly "true" to run against the in-memory mocks, which
# is useful when the API is not running. Anything else — including leaving this
# out — talks to the real API. Never set it in a production build: the mocks
# invent patients and payments and log in a demo admin without a password.
# VITE_API_MOCKS=true
