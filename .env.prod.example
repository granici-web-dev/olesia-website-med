# Environment for docker-compose.prod.yml. Copy to `.env` next to it and fill
# it in. Everything without a default here is refused at startup rather than
# guessed, so an incomplete file fails immediately instead of booting weakly.
#
#   cp .env.prod.example .env
#   docker compose -f docker-compose.prod.yml up -d
#
# NODE_ENV is deliberately absent: the API image sets it, and overriding it is
# how Swagger and stack traces end up on a public host.

# --- hostnames and TLS ------------------------------------------------------
# The two names Caddy answers on. Both need an A record pointing at this server
# before the first start, or the certificate request fails.
CADDY_API_HOST=api.oleseajalba.md
CADDY_ADMIN_HOST=admin.oleseajalba.md
# Where Let's Encrypt sends expiry warnings. Leave EMPTY for a local run and
# Caddy issues its own certificate instead.
ACME_EMAIL=

# --- database ---------------------------------------------------------------
POSTGRES_USER=olesia
# openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=
POSTGRES_DB=olesia

# --- origins ----------------------------------------------------------------
# Exact origins allowed to call the API with credentials. The public site and
# the admin host; no wildcards, no trailing slash.
CORS_ORIGINS=https://oleseajalba.md,https://www.oleseajalba.md,https://admin.oleseajalba.md
# Used to build URLs for uploaded images.
PUBLIC_API_URL=https://api.oleseajalba.md
# Used to build the patient upload link. The SITE, not the API.
PUBLIC_SITE_URL=https://oleseajalba.md

# --- sessions ---------------------------------------------------------------
# Two different values, 32 characters minimum; the API exits if either is short
# or if they match. Rotating them logs everyone out.
#   openssl rand -base64 36
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Caddy terminates TLS in front of the API. Only ever false behind a proxy the
# cookie never leaves in clear.
COOKIE_SECURE=true

# --- the first administrator ------------------------------------------------
# Read by the seed, not by the API. The seed refuses to run with SEED_PROFILE=
# prod unless both are set, and the account it creates must change its password
# at first login.
ADMIN_EMAIL=
# openssl rand -base64 18
ADMIN_PASSWORD=

# --- booking ----------------------------------------------------------------
# Empty until the client's paid Calendly exists. The webhook rejects everything
# while the signing key is blank, which is the correct state, not a fault.
CALENDLY_API_TOKEN=
CALENDLY_ORG_URI=
CALENDLY_WEBHOOK_SIGNING_KEY=

# --- online payment ---------------------------------------------------------
# Empty means payment is off; the API logs one line at startup saying so. Fill
# these only once the maib contract exists and the callback URL is registered.
MAIB_BASE_URL=
MAIB_CLIENT_ID=
MAIB_CLIENT_SECRET=
MAIB_SIGNATURE_KEY=

# --- email ------------------------------------------------------------------
# Empty SMTP_* means log-only: leads are still stored, patients are not
# emailed, and the back office reports that nothing was sent rather than
# showing a false success.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# REQUIRED in production — the API exits at boot without it. It has no
# default: it used to fall back to a developer's personal Gmail, so a
# deployment that forgot the variable sent every lead, medical questions
# included, to a private mailbox.
LEADS_NOTIFY_EMAIL=

# --- spam protection --------------------------------------------------------
# REQUIRED in production — the API exits at boot without it. Empty disables
# verification entirely, and doing that silently is the problem.
RECAPTCHA_SECRET=
# reCAPTCHA v3 score below which a request is treated as a bot.
RECAPTCHA_MIN_SCORE=0.5

# --- patient uploads (§11.14) -----------------------------------------------
# How long an upload link keeps accepting files.
UPLOAD_LINK_TTL_DAYS=30
# ⚠ PLACEHOLDER. How long medical files are kept before the purge job deletes
# them, row and bytes. The real number is the client's lawyer's to give.
MEDICAL_UPLOAD_RETENTION_DAYS=180
UPLOAD_MAX_FILES=15

# --- backups ----------------------------------------------------------------
BACKUP_KEEP_DAYS=14
# Local hour of the nightly run, in BACKUP_TZ. Two digits.
BACKUP_HOUR=03
BACKUP_TZ=Europe/Chisinau
# Off-site copy, in rclone's syntax ("olesia-offsite:backups"). Empty means the
# step is skipped and says so in the log. The destination must be in the EU:
# these archives hold medical data.
RCLONE_REMOTE=
