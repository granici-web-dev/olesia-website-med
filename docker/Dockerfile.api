# Multi-stage build for apps/api (NestJS).
#
# The runtime stage installs from `nx prune`'s output — a manifest and lockfile
# holding only what the bundle actually requires, plus `@olesia/shared` copied
# in as a real package. The workspace's own `node_modules` never reaches the
# image: it is 2 GB of build tooling, and the earlier attempt to ship it also
# shipped a `@olesia/shared` symlink pointing at a `packages/` directory that
# was never copied, which is why the container could not start at all.

# --- builder ---
FROM node:22-slim AS builder
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app

# OpenSSL is needed by Prisma's query engine.
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*

COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm exec prisma generate --schema apps/api/prisma/schema.prisma
# `prune` depends on `build`, so this compiles main.js and seed.js as well.
RUN pnpm nx prune api

# --- runtime ---
FROM node:22-slim AS runtime
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app
ENV NODE_ENV=production

RUN apt-get update -y && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/apps/api/dist ./
RUN pnpm install --prod --frozen-lockfile && pnpm store prune

COPY --from=builder /app/apps/api/prisma ./prisma
COPY --from=builder /app/apps/api/prisma.config.ts ./prisma.config.ts

# The volumes mount empty; Docker copies this ownership onto them, which is what
# lets an unprivileged process write uploads.
RUN mkdir -p /app/uploads /app/private-uploads \
  && chown -R node:node /app/uploads /app/private-uploads

USER node
EXPOSE 3333

# Apply pending migrations, then start the server. The seed is deliberately not
# here: it is a runbook step (`node seed.js`), run once, by a person who has the
# administrator password in hand.
CMD ["sh", "-c", "node_modules/.bin/prisma migrate deploy --schema prisma/schema.prisma && node main.js"]
